<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="InvoiceValidationService"
    targetNamespace="https://www.agenciatributaria.gob.es/spfe/ns/services/InvoiceValidation/v1"
    xmlns:tns="https://www.agenciatributaria.gob.es/spfe/ns/services/InvoiceValidation/v1"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
    xmlns:ublds="urn:oasis:names:specification:ubl:schema:xsd:DocumentStatus-2">

    <wsdl:documentation>
        SPFE (Solución Pública de Factura Electrónica) - servicio InvoiceValidation - entorno PRE.

        Servicio SOAP 1.1 document/literal (sin mensajería ebXML):
        - El body de la petición es directamente una factura UBL: elemento ubl:Invoice,
          de tipo InvoiceType.
        - El body de la respuesta es un documento UBL DocumentStatus (elemento
          ublds:DocumentStatus, de tipo DocumentStatusType) con los errores de validación
          detectados.
        - Los errores se devuelven como SOAP Fault estándar de SOAP 1.1 (faultcode y
          faultstring), sin elemento detail propio.

        Acceso: dos puertos alternativos y equivalentes, cada uno con su propio dominio:
        - InvoiceValidationCertPort: acceso con certificado electrónico (no de sello).
        - InvoiceValidationSealPort: acceso con certificado de sello electrónico.
    </wsdl:documentation>

    <!-- ============================================================
         TYPES
         Se importan los esquemas UBL de la factura (Invoice / InvoiceType)
         y del estado de documento (DocumentStatus / DocumentStatusType),
         con rutas relativas a este WSDL. Los esquemas UBL deben estar bajo
         xsd/ con la estructura oficial de OASIS (maindoc/ y common/).
         ============================================================ -->
    <wsdl:types>
        <xsd:schema targetNamespace="https://www.agenciatributaria.gob.es/spfe/ns/services/InvoiceValidation/v1" elementFormDefault="qualified">
            <xsd:import
                namespace="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
                schemaLocation="xsd/ubl-2.5/maindoc/UBL-Invoice-2.5.xsd"/>

            <xsd:import
                namespace="urn:oasis:names:specification:ubl:schema:xsd:DocumentStatus-2"
                schemaLocation="xsd/ubl-2.5/maindoc/UBL-DocumentStatus-2.5.xsd"/>
        </xsd:schema>
    </wsdl:types>

    <!-- ============================================================
         MESSAGES
         ============================================================ -->
    <wsdl:message name="InvoiceValidationRequest">
        <wsdl:part name="invoice" element="ubl:Invoice"/>
    </wsdl:message>

    <wsdl:message name="InvoiceValidationResponse">
        <wsdl:part name="documentStatus" element="ublds:DocumentStatus"/>
    </wsdl:message>

    <!-- ============================================================
         PORT TYPE
         ============================================================ -->
    <wsdl:portType name="InvoiceValidationPortType">
        <wsdl:operation name="InvoiceValidation">
            <wsdl:documentation>
                Recibe una factura UBL (ubl:Invoice) y devuelve un UBL DocumentStatus
                (ublds:DocumentStatus) con los errores de validación detectados.
            </wsdl:documentation>
            <wsdl:input name="InvoiceValidationInput" message="tns:InvoiceValidationRequest"/>
            <wsdl:output name="InvoiceValidationOutput" message="tns:InvoiceValidationResponse"/>
        </wsdl:operation>
    </wsdl:portType>

    <!-- ============================================================
         BINDING: SOAP 1.1, document/literal
         ============================================================ -->
    <wsdl:binding name="InvoiceValidationSoapBinding" type="tns:InvoiceValidationPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="InvoiceValidation">
            <soap:operation soapAction="https://www.agenciatributaria.gob.es/spfe/ns/services/InvoiceValidation/v1/InvoiceValidation"/>
            <wsdl:input name="InvoiceValidationInput">
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output name="InvoiceValidationOutput">
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <!-- ============================================================
         SERVICE
         Un wsdl:port admite una unica direccion (WSDL 1.1, sec. 2.6), por
         eso cada modo de acceso, con su dominio, es un puerto distinto.
         Los dos puertos son alternativas equivalentes del mismo servicio.
         ============================================================ -->
    <wsdl:service name="InvoiceValidationService">
        <wsdl:port name="InvoiceValidationCertPort" binding="tns:InvoiceValidationSoapBinding">
            <wsdl:documentation>Acceso con certificado electrónico (no de sello).</wsdl:documentation>
            <soap:address location="https://prewww1.aeat.es/wlpl/SPFE-FACT/ws/InvoiceValidationSOAP"/>
        </wsdl:port>
        <wsdl:port name="InvoiceValidationSealPort" binding="tns:InvoiceValidationSoapBinding">
            <wsdl:documentation>Acceso con certificado de sello electrónico.</wsdl:documentation>
            <soap:address location="https://prewww10.aeat.es/wlpl/SPFE-FACT/ws/InvoiceValidationSOAP"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
