<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="GetInvoicesService"
    targetNamespace="https://www.agenciatributaria.gob.es/spfe/ns/services/GetInvoices/v1"
    xmlns:tns="https://www.agenciatributaria.gob.es/spfe/ns/services/GetInvoices/v1"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:mime="http://schemas.xmlsoap.org/wsdl/mime/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:eb3="http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/ns/core/200704/">

    <wsdl:documentation>
        SPFE (Solución Pública de Factura Electrónica) - servicio GetInvoices - entorno PRE.

        Mensajería ebMS 3.0:
        - La cabecera eb3:Messaging viaja en el header SOAP; el body SOAP va vacío.
        - Los errores se devuelven como SOAP Fault estándar de SOAP 1.1 (faultcode y
          faultstring), sin elemento detail propio.
        - Los documentos UBL de entrada y salida viajan como adjuntos MIME, referenciados
          desde eb3:UserMessage/PayloadInfo/PartInfo mediante href="cid:...".
        - WSDL 1.1 no permite declarar un número variable de adjuntos: este WSDL describe una
          única parte "payload" a título orientativo, y el mensaje puede llevar tantos
          adjuntos como PartInfo declare la cabecera ebMS.

        Acceso: dos puertos alternativos y equivalentes, cada uno con su propio dominio:
        - GetInvoicesCertPort: acceso con certificado electrónico (no de sello).
        - GetInvoicesSealPort: acceso con certificado de sello electrónico.
    </wsdl:documentation>

    <!-- ============================================================
         TYPES
         Solo se importa el esquema de mensajería ebMS 3.0 (ruta relativa
         a este WSDL). Los documentos UBL no se tipan aquí: viajan como
         adjuntos opacos y se validan en la capa de negocio.
         ============================================================ -->
    <wsdl:types>
        <xsd:schema targetNamespace="https://www.agenciatributaria.gob.es/spfe/ns/services/GetInvoices/v1" elementFormDefault="qualified">
            <xsd:import
                namespace="http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/ns/core/200704/"
                schemaLocation="xsd/ebms/ebms-header-3_0-200704.xsd"/>
        </xsd:schema>
    </wsdl:types>

    <!-- ============================================================
         MESSAGES
         - ebmsHeader: cabecera eb3:Messaging (header SOAP)
         - payload:    adjunto MIME con el documento UBL (contenido opaco,
                       base64Binary a nivel WSDL)
         ============================================================ -->
    <wsdl:message name="GetInvoicesRequest">
        <wsdl:part name="ebmsHeader" element="eb3:Messaging"/>
        <wsdl:part name="payload" type="xsd:base64Binary"/>
    </wsdl:message>

    <wsdl:message name="GetInvoicesResponse">
        <wsdl:part name="ebmsHeader" element="eb3:Messaging"/>
        <wsdl:part name="payload" type="xsd:base64Binary"/>
    </wsdl:message>

    <!-- ============================================================
         PORT TYPE
         ============================================================ -->
    <wsdl:portType name="GetInvoicesPortType">
        <wsdl:operation name="GetInvoices">
            <wsdl:documentation>
                Recibe un mensaje ebMS 3.0 con los documentos UBL adjuntos y devuelve un
                mensaje ebMS 3.0 (señal Receipt y/o UserMessage de respuesta) con los
                documentos UBL de respuesta adjuntos.
            </wsdl:documentation>
            <wsdl:input name="GetInvoicesInput" message="tns:GetInvoicesRequest"/>
            <wsdl:output name="GetInvoicesOutput" message="tns:GetInvoicesResponse"/>
        </wsdl:operation>
    </wsdl:portType>

    <!-- ============================================================
         BINDING: SOAP 1.1 + MIME multipart
         - eb3:Messaging como soap:header en petición y respuesta
         - body SOAP vacío (patrón ebMS 3.0 / AS4)
         - documentos UBL como adjuntos MIME (Content-ID = cid: de cada PartInfo)
         ============================================================ -->
    <wsdl:binding name="GetInvoicesSoapBinding" type="tns:GetInvoicesPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="GetInvoices">
            <soap:operation soapAction="https://www.agenciatributaria.gob.es/spfe/ns/services/GetInvoices/v1/GetInvoices"/>

            <wsdl:input name="GetInvoicesInput">
                <mime:multipartRelated>
                    <mime:part>
                        <soap:header message="tns:GetInvoicesRequest"
                                     part="ebmsHeader" use="literal"/>
                        <soap:body parts="" use="literal"/>
                    </mime:part>
                    <mime:part>
                        <mime:content part="payload" type="application/xml"/>
                    </mime:part>
                </mime:multipartRelated>
            </wsdl:input>

            <wsdl:output name="GetInvoicesOutput">
                <mime:multipartRelated>
                    <mime:part>
                        <soap:header message="tns:GetInvoicesResponse"
                                     part="ebmsHeader" use="literal"/>
                        <soap:body parts="" use="literal"/>
                    </mime:part>
                    <mime:part>
                        <mime:content part="payload" type="application/xml"/>
                    </mime:part>
                </mime:multipartRelated>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <!-- ============================================================
         SERVICE
         Un wsdl:port admite una unica direccion (WSDL 1.1, sec. 2.6), por
         eso cada modo de acceso, con su dominio, es un puerto distinto.
         Los dos puertos son alternativas equivalentes del mismo servicio.
         ============================================================ -->
    <wsdl:service name="GetInvoicesService">
        <wsdl:port name="GetInvoicesCertPort" binding="tns:GetInvoicesSoapBinding">
            <wsdl:documentation>Acceso con certificado electrónico (no de sello).</wsdl:documentation>
            <soap:address location="https://prewww1.aeat.es/wlpl/SPFE-FACT/ws/GetInvoicesSOAP"/>
        </wsdl:port>
        <wsdl:port name="GetInvoicesSealPort" binding="tns:GetInvoicesSoapBinding">
            <wsdl:documentation>Acceso con certificado de sello electrónico.</wsdl:documentation>
            <soap:address location="https://prewww10.aeat.es/wlpl/SPFE-FACT/ws/GetInvoicesSOAP"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
